{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "outputDirectory": "dist/client",
  "env": {
    "DATABASE_URL": "@DATABASE_URL",
    "OPENAI_API_KEY": "@OPENAI_API_KEY",
    "JWT_SECRET": "@JWT_SECRET",
    "NODE_ENV": "production"
  },
  "regions": ["iad1"],
  "github": {
    "enabled": true,
    "autoAlias": true
  }
}
